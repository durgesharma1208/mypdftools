# Backend API base URL. Leave empty to use the same origin (Vite dev proxy or
# nginx in Docker forwards /api to the backend on port 8000).
VITE_API_URL=

# Set to http://localhost:8000 when the frontend is served from a different
# origin and the proxy is not available.
# VITE_API_URL=http://localhost:8000
# --- Development server -------------------------------------------------------
# Ports and proxy target used by `npm run dev` / `npm run preview`.
# VITE_DEV_PORT=5173
# VITE_PREVIEW_PORT=4173
# VITE_DEV_PROXY_TARGET=http://localhost:8000
# Comma-separated list of accepted Host headers. Empty (default) accepts any
# host so container/tunnel previews work; set it to lock the dev server down.
# VITE_DEV_ALLOWED_HOSTS=localhost,127.0.0.1
