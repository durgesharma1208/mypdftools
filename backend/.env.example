# Application
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Security / upload limits
MAX_FILE_SIZE_MB=50
MAX_FILES=10

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: explicit path to soffice.exe (LibreOffice)
# Used for Word/Excel/PowerPoint -> PDF conversions.
# If empty, the app searches PATH and common install locations.
LIBREOFFICE_PATH=

# Optional: explicit path to ghostscript binary
# Used as an accelerator for high compression when available.
GHOSTSCRIPT_PATH=

# Working directories (relative to backend/ unless absolute)
TEMP_DIR=temp
OUTPUT_DIR=output
TESSDATA_DIR=tessdata

# AI / Document Intelligence (Server-side only — never exposed to client)
# Add your API key here to enable PDF Summary and Ask Questions tools.
# Any OpenAI-compatible provider works (OpenAI, Groq, OpenRouter, Ollama, etc.)
API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
MAX_AI_DOCUMENT_PAGES=100